# font_family      JetBrainsMono Nerd Font
font_size        12.0
background_opacity     0.90
window_padding_width   12
confirm_os_window_close 0
enable_audio_bell      no
scrollback_lines       10000


# BEGIN_KITTY_THEME
# Gruvbox Dark
include current-theme.conf
#RED 	- #FF5C5C
#GREEN 	- #98FB98
#CYAN 	- #3198FF
#PURPLE - #AE5CFF
#YELLOW - #FFFF5C

background		#000000
foreground		#98FB98
selection_background	#FF5C5C
selection_foreground	#98FB98
cursor			#FF5C5C
cursor_text_color	#98FB98
url_color		#3198FF
active_tab_background	#AE5CFF
active_tab_foreground	#000000
inactive_tab_foreground	#FFFF5C
# END_KITTY_THEME


# BEGIN_KITTY_FONTS
font_family      family="Nimbus Mono PS"
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS